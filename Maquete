#include <WiFi.h>
#include <WebServer.h>

// ====================================================
// CONFIGURAÇÃO DO WI-FI
// ====================================================
const char* ssid = "TESTE_ESP";
const char* password = "TESTE_ESP";

WebServer server(80);

// ====================================================
// PINOS DAS VAGAS
// ====================================================
const int trigPins[] = {5, 16, 21};
const int echoPins[] = {18, 17, 19};
const int ledPins[]  = {4, 14, 26};

// Guarda o estado de cada vaga
bool vagasOcupadas[3] = {false, false, false};

// ====================================================
// PINOS DO ADAS
// ====================================================
const int trigPinsAdas[] = {12};
const int echoPinsAdas[] = {13};
const int ledPinsAdas[]  = {25, 33, 32};

// ====================================================
// ROTA PRINCIPAL (Envia a estrutura estática do site)
// ====================================================
void handleRoot() {
  String html = R"rawliteral(
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Estacionamento Inteligente</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f2f2f2; text-align: center; margin: 0; padding: 30px; }
    h1 { color: #222; }
    .container { max-width: 600px; margin: auto; }
    .resumo { display: flex; justify-content: center; gap: 20px; margin: 30px 0; }
    .card { background: white; padding: 25px; border-radius: 15px; box-shadow: 0 3px 10px rgba(0,0,0,0.15); flex: 1; }
    .numero { font-size: 45px; font-weight: bold; }
    .disponivel { color: #16a34a; }
    .ocupado { color: #dc2626; }
    .vagas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
    .vaga { background: white; padding: 20px; border-radius: 15px; box-shadow: 0 3px 10px rgba(0,0,0,0.15); }
    .status { font-size: 18px; font-weight: bold; }
  </style>
</head>
<body>

<div class="container">
  <h1>Estacionamento Inteligente</h1>

  <div class="resumo">
    <div class="card">
      <div>Vagas disponíveis</div>
      <div id="vagas-disponiveis" class="numero disponivel">--</div>
    </div>
    <div class="card">
      <div>Vagas ocupadas</div>
      <div id="vagas-ocupadas" class="numero ocupado">--</div>
    </div>
  </div>

  <h2>Estado das vagas</h2>

  <div class="vagas">
    <div class="vaga">
      <h3>Vaga 1</h3>
      <div id="vaga1" class="status">Carregando...</div>
    </div>
    <div class="vaga">
      <h3>Vaga 2</h3>
      <div id="vaga2" class="status">Carregando...</div>
    </div>
    <div class="vaga">
      <h3>Vaga 3</h3>
      <div id="vaga3" class="status">Carregando...</div>
    </div>
  </div>

  <p style="margin-top:30px;color:#777;">
    Atualização em tempo real via AJAX
  </p>
</div>

<script>
  // Função que busca os dados atualizados do ESP32 via AJAX
  function atualizarDados() {
    fetch('/status')
      .then(response => response.json())
      .then(dados => {
        // Atualiza os contadores principais
        document.getElementById('vagas-disponiveis').innerText = dados.disp;
        document.getElementById('vagas-ocupadas').innerText = dados.ocup;

        // Atualiza a Vaga 1
        let v1 = document.getElementById('vaga1');
        v1.innerHTML = dados.v1 ? "🔴 Ocupada" : "🟢 Disponível";
        v1.className = dados.v1 ? "status ocupado" : "status disponivel";

        // Atualiza a Vaga 2
        let v2 = document.getElementById('vaga2');
        v2.innerHTML = dados.v2 ? "🔴 Ocupada" : "🟢 Disponível";
        v2.className = dados.v2 ? "status ocupado" : "status disponivel";

        // Atualiza a Vaga 3
        let v3 = document.getElementById('vaga3');
        v3.innerHTML = dados.v3 ? "🔴 Ocupada" : "🟢 Disponível";
        v3.className = dados.v3 ? "status ocupado" : "status disponivel";
      })
      .catch(err => console.error("Erro ao buscar dados do ESP32:", err));
  }

  // Executa a função imediatamente ao abrir o site
  atualizarDados();
  // Configura para rodar repetidamente a cada 1 segundo (1000ms)
  setInterval(atualizarDados, 1000);
</script>

</body>
</html>
)rawliteral";

  server.send(200, "text/html", html);
}

// ====================================================
// NOVA ROTA AJAX (Envia apenas os dados puros em JSON)
// ====================================================
void handleStatus() {
  int vagasOcupadasCount = 0;
  for (int i = 0; i < 3; i++) {
    if (vagasOcupadas[i]) vagasOcupadasCount++;
  }
  int vagasDisponiveis = 3 - vagasOcupadasCount;

  // Monta a string JSON de forma leve e rápida
  String json = "{";
  json += "\"disp\":" + String(vagasDisponiveis) + ",";
  json += "\"ocup\":" + String(vagasOcupadasCount) + ",";
  json += "\"v1\":" + String(vagasOcupadas[0] ? "true" : "false") + ",";
  json += "\"v2\":" + String(vagasOcupadas[1] ? "true" : "false") + ",";
  json += "\"v3\":" + String(vagasOcupadas[2] ? "true" : "false");
  json += "}";

  server.send(200, "application/json", json);
}

// ====================================================
// SETUP
// ====================================================
void setup() {
  Serial.begin(115200);

  // Configura os pinos das Vagas
  for (int i = 0; i < 3; i++) {
    pinMode(trigPins[i], OUTPUT);
    digitalWrite(trigPins[i], LOW);
    pinMode(echoPins[i], INPUT);
    pinMode(ledPins[i], OUTPUT);
    digitalWrite(ledPins[i], LOW);
  }

  // Configura os pinos do ADAS
  pinMode(trigPinsAdas[0], OUTPUT);
  digitalWrite(trigPinsAdas[0], LOW);
  pinMode(echoPinsAdas[0], INPUT);

  for (int i = 0; i < 3; i++) {
    pinMode(ledPinsAdas[i], OUTPUT);
    digitalWrite(ledPinsAdas[i], LOW);
  }

  // Conecta ao Wi-Fi
  Serial.println("\nConectando ao Wi-Fi...");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWi-Fi conectado!");
  Serial.print("IP do ESP32: ");
  Serial.println(WiFi.localIP());

  // Rotas do Servidor Web
  server.on("/", handleRoot);
  server.on("/status", handleStatus); // <-- Rota que o AJAX vai chamar

  server.begin();
  Serial.println("Servidor web iniciado!");
}

// ====================================================
// LOOP (Inalterado)
// ====================================================
void loop() {
  server.handleClient();

  // 1. VAGAS
  for (int i = 0; i < 3; i++) {
    long distancia = medirDistancia(trigPins[i], echoPins[i]);

    Serial.print("Vaga "); Serial.print(i + 1); Serial.print(": ");
    Serial.print(distancia); Serial.print(" cm | ");

    if (distancia <= 20 && distancia > 0) {
      vagasOcupadas[i] = true;
      digitalWrite(ledPins[i], HIGH);
    } else {
      vagasOcupadas[i] = false;
      digitalWrite(ledPins[i], LOW);
    }
    delay(40);
  }

  // 2. ADAS
  long distAdas = medirDistancia(trigPinsAdas[0], echoPinsAdas[0]);
  Serial.print("ADAS: "); Serial.print(distAdas); Serial.println(" cm");

  if (distAdas > 0 && distAdas < 13) {
    digitalWrite(ledPinsAdas[0], HIGH); digitalWrite(ledPinsAdas[1], LOW); digitalWrite(ledPinsAdas[2], LOW);
  } else if (distAdas >= 13 && distAdas < 30) {
    digitalWrite(ledPinsAdas[0], LOW); digitalWrite(ledPinsAdas[1], HIGH); digitalWrite(ledPinsAdas[2], LOW);
  } else if (distAdas >= 30 && distAdas < 50) {
    digitalWrite(ledPinsAdas[0], LOW); digitalWrite(ledPinsAdas[1], LOW); digitalWrite(ledPinsAdas[2], HIGH);
  } else {
    digitalWrite(ledPinsAdas[0], LOW); digitalWrite(ledPinsAdas[1], LOW); digitalWrite(ledPinsAdas[2], LOW);
  }

  Serial.println("----------------------------------------");
  delay(100);
}

// ====================================================
// MEDIR DISTÂNCIA (Inalterado)
// ====================================================
long medirDistancia(int pinoTrig, int pinoEcho) {
  digitalWrite(pinoTrig, LOW);
  delayMicroseconds(2);
  digitalWrite(pinoTrig, HIGH);
  delayMicroseconds(10);
  digitalWrite(pinoTrig, LOW);

  long tempo = pulseIn(pinoEcho, HIGH, 30000);
  if (tempo == 0) return 999;
  return tempo / 58;
}
