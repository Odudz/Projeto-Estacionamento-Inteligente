void handleRoot() {
    server.send_P(200, "text/html; charset=utf-8", html);
}

// Os dados podem ser consultados pela rede em /status.
void handleStatus() {
    bool pronto = vagasVerificadas;
    for (int i = 0; i < NUM_SENSORES; i++) {
        if (!vagasConhecidas[i] || distanciasVaga[i] == 0 ||
            millis() - ultimaLeituraVaga[i] > 2000) pronto = false;
    }

    String json = "{";
    json += "\"pronto\":" + String(pronto ? "true" : "false") + ",";
    json += "\"disp\":" + String(NUM_SENSORES - contarVagasOcupadas()) + ",";
    json += "\"ocup\":" + String(contarVagasOcupadas()) + ",";
    json += "\"cancela\":" + String(cancelaAberta ? "true" : "false") + ",";
    json += "\"entrada_pendente\":" + String(entradaPendente ? "true" : "false") + ",";

    for (int i = 0; i < NUM_SENSORES; i++) {
        json += "\"v" + String(i + 1) + "\":";
        json += vagasConhecidas[i] ? (vagasOcupadas[i] ? "true" : "false") : "null";
        json += ",";
    }

    json += "\"vagas\":[";
    for (int i = 0; i < NUM_SENSORES; i++) {
        if (i > 0) json += ",";
        json += String(distanciasVaga[i]);
    }
    json += "],\"adas\":[";
    for (int i = 0; i < NUM_SENSORES; i++) {
        if (i > 0) json += ",";
        json += String(distanciasAdas[i]);
    }
    json += "],";

    json += "\"wifi\":\"" + String(WiFi.status() == WL_CONNECTED ? "Conectado" : "Desconectado") + "\",";
    json += "\"ip\":\"" + WiFi.localIP().toString() + "\",";
    json += "\"mac\":\"" + WiFi.macAddress() + "\"";
    json += "}";

    server.send(200, "application/json", json);
}

// Recebe comandos do painel por POST, sem senha de controle.
void handleComando() {
    const String acao = server.arg("acao");
    if (acao == "entrada") {
        if (entradaPendente || cancelaAberta) {
            server.send(409, "text/plain", "Cancela ocupada ou entrada em verificacao.");
            return;
        }
        solicitarEntrada();
        server.send(202, "text/plain", "Verificando vagas para liberar a entrada.");
    } else if (acao == "saida") {
        entradaPendente = false;
        abrirCancela();
        leiturasPrioritarias = LEITURAS_VERIFICACAO;
        server.send(200, "text/plain", "Saida liberada.");
    } else if (acao == "fechar") {
        entradaPendente = false;
        fecharCancela();
        registrar("INFO", "Fechamento remoto solicitado.");
        server.send(200, "text/plain", "Comando de fechamento recebido.");
    } else {
        registrar("WARNING", "Comando remoto desconhecido.");
        server.send(400, "text/plain", "Comando desconhecido.");
    }
}


/*
   Inicializacao e loop principal
*/

void setup() {
    Serial.begin(115200);
    cancela.setPeriodHertz(50);
    cancela.attach(PINO_SERVO, 500, 2400);
    cancela.write(ANGULO_FECHADO);

    pinMode(botaoPin, INPUT_PULLUP);
    pinMode(botaoSaida, INPUT_PULLUP);

    for (int i = 0; i < NUM_SENSORES; i++) {
        pinMode(trigPins[i], OUTPUT);
        digitalWrite(trigPins[i], LOW);
        pinMode(echoPins[i], INPUT);
        pinMode(ledPins[i], OUTPUT);
        digitalWrite(ledPins[i], LOW);

        pinMode(trigPinsAdas[i], OUTPUT);
        digitalWrite(trigPinsAdas[i], LOW);
        pinMode(echoPinsAdas[i], INPUT);
        pinMode(ledPinsAdas[i], OUTPUT);
        digitalWrite(ledPinsAdas[i], LOW);
    }

    flashDisponivel = LittleFS.begin(FORMATAR_FLASH_SE_NECESSARIO);
    if (!flashDisponivel) Serial.println("[ERROR] LittleFS nao montou. Logs apenas na Serial.");
    registrar("INFO", "Estacionamento iniciado.");

    WiFi.mode(WIFI_STA);
    WiFi.setAutoReconnect(true);
    WiFi.begin(ssid, password);

    server.on("/", HTTP_GET, handleRoot);
    server.on("/status", HTTP_GET, handleStatus);
    server.on("/logs", HTTP_GET, handleLogs);
    server.on("/comando", HTTP_POST, handleComando);
    server.begin();
    registrar("INFO", "Servidor web iniciado.");

    Serial.println("Botao de entrada: GPIO 22 | Saida: GPIO 23 | Servo: GPIO 27");
}

void loop() {
    if (cancelaAberta && millis() - aberturaCancela >= TEMPO_ABERTO) {
        fecharCancela();
    }

    if (entrada.novoClique()) solicitarEntrada();
    if (saida.novoClique()) {
        entradaPendente = false;
        abrirCancela();
        leiturasPrioritarias = LEITURAS_VERIFICACAO;
    }

    verificarProximoSensor();
    server.handleClient();

    static bool wifiAnterior = false;
    static bool relogioIniciado = false;
    static unsigned long ultimaTentativa = 0;
    bool conectado = WiFi.status() == WL_CONNECTED;

    if (conectado && !wifiAnterior) {
        registrar("INFO", "Wi-Fi conectado. IP: " + WiFi.localIP().toString() +
                          " | MAC: " + WiFi.macAddress());
        Serial.println("Pagina: http://" + WiFi.localIP().toString());
        if (!relogioIniciado) {
            configTzTime("<-03>3", "pool.ntp.org");  // Horario de Brasilia (UTC-3).
            relogioIniciado = true;
        }
    }
    if (!conectado && wifiAnterior) registrar("WARNING", "Wi-Fi desconectado.");
    if (!conectado && millis() - ultimaTentativa >= 30000) {
        ultimaTentativa = millis();
        WiFi.reconnect();
    }
    wifiAnterior = conectado;
}
