#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>


const char* ssid = "TESTE_ESP";
const char* password = "TESTE_ESP";

WebServer server(80);

/*
  Entradas organizadas em listas, facilitando uso de multiplas entradas/sensores
*/

const int botaoPin = 22;
const int botaoSaida = 23;
const unsigned long TEMPO_DEBOUNCE = 25;

struct Botao {
    explicit Botao(int pino) : pino(pino) {}

    bool novoClique() {
        const unsigned long agora = millis();
        const bool leitura = digitalRead(pino) == LOW;
        if (leitura != leituraAnterior) {
            leituraAnterior = leitura;
            ultimaMudanca = agora;
        }

        if (leitura == pressionado || agora - ultimaMudanca < TEMPO_DEBOUNCE) {
            return false;
        }

        pressionado = leitura;
        return pressionado;
    }

    const int pino;
    bool leituraAnterior = false;
    bool pressionado = false;
    unsigned long ultimaMudanca = 0;
};

Botao entrada(botaoPin);
Botao saida(botaoSaida);

// Estacionamento
// Sensor Ultrassonico
const int trigPins[] = {5, 16, 21};
const int echoPins[] = {18, 17, 19};
const int ledPins[]  = {4, 14, 26};

// Adas (Veiculos Passando na Frente)
const int trigPinsAdas[] = {12, 15, 2};
const int echoPinsAdas[] = {13, 34, 35};
const int ledPinsAdas[]  = {32, 33, 25};

const int DISTANCIA_ADAS_CM = 6;
const int DISTANCIA_OCUPADA_CM = 20;
const int DISTANCIA_ORIENTACAO_CM = 12;

/*
  Variaveis do sistema
*/

// Número total de sensores
const int NUM_SENSORES = sizeof(trigPins) / sizeof(trigPins[0]);

const int PINO_SERVO = 27;
const int ANGULO_FECHADO = 105;
const int ANGULO_ABERTO = 15;
const unsigned long TEMPO_ABERTO = 3000;
const unsigned long INTERVALO_SENSORES = 60;
const unsigned long TEMPO_MAX_ECO_US = 4000;
const int LEITURAS_VERIFICACAO = 2 * NUM_SENSORES;
Servo cancela;
bool cancelaAberta = false;
unsigned long aberturaCancela = 0;
bool vagasOcupadas[NUM_SENSORES] = {};
bool mudancaPendente[NUM_SENSORES] = {};
bool vagasEmOrientacao[NUM_SENSORES] = {};
int leiturasPrioritarias = LEITURAS_VERIFICACAO;
bool vagasVerificadas = false;
bool entradaPendente = false;

void abrirCancela() {
    cancela.write(ANGULO_ABERTO);
    aberturaCancela = millis();
    cancelaAberta = true;
}

int contarVagasOcupadas() {
    int ocupadas = 0;
    for (int i = 0; i < NUM_SENSORES; i++) {
        if (vagasOcupadas[i]) ocupadas++;
    }
    return ocupadas;
}

void handleRoot() {
  String html = R"rawliteral(
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Estacionamento Inteligente</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f2f2f2; text-align: center; margin: 0; padding: 30px; }
    h1 { color: #222; }
    .container { max-width: 600px; margin: auto; }
    .resumo { display: flex; justify-content: center; gap: 20px; margin: 30px 0; }
    .card { background: white; padding: 25px; border-radius: 15px; box-shadow: 0 3px 10px rgba(0,0,0,0.15); flex: 1; }
    .numero { font-size: 45px; font-weight: bold; }
    .disponivel { color: #16a34a; }
    .ocupado { color: #dc2626; }
    .vagas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
    .vaga { background: white; padding: 20px; border-radius: 15px; box-shadow: 0 3px 10px rgba(0,0,0,0.15); }
    .status { font-size: 18px; font-weight: bold; }
  </style>
</head>
<body>

<div class="container">
  <h1>Estacionamento Inteligente</h1>

  <div class="resumo">
    <div class="card">
      <div>Vagas disponíveis</div>
      <div id="vagas-disponiveis" class="numero disponivel">--</div>
    </div>
    <div class="card">
      <div>Vagas ocupadas</div>
      <div id="vagas-ocupadas" class="numero ocupado">--</div>
    </div>
  </div>

  <h2>Estado das vagas</h2>

  <div class="vagas">
    <div class="vaga">
      <h3>Vaga 1</h3>
      <div id="vaga1" class="status">Carregando...</div>
    </div>
    <div class="vaga">
      <h3>Vaga 2</h3>
      <div id="vaga2" class="status">Carregando...</div>
    </div>
    <div class="vaga">
      <h3>Vaga 3</h3>
      <div id="vaga3" class="status">Carregando...</div>
    </div>
  </div>

  <p style="margin-top:30px;color:#777;">
    Atualização em tempo real via AJAX
  </p>
</div>

<script>
  // Função que busca os dados atualizados do ESP32 via AJAX
  function atualizarDados() {
    fetch('/status')
      .then(response => response.json())
      .then(dados => {
        if (!dados.pronto) return;

        // Atualiza os contadores principais
        document.getElementById('vagas-disponiveis').innerText = dados.disp;
        document.getElementById('vagas-ocupadas').innerText = dados.ocup;

        // Atualiza a Vaga 1
        let v1 = document.getElementById('vaga1');
        v1.innerHTML = dados.v1 ? "🔴 Ocupada" : "🟢 Disponível";
        v1.className = dados.v1 ? "status ocupado" : "status disponivel";

        // Atualiza a Vaga 2
        let v2 = document.getElementById('vaga2');
        v2.innerHTML = dados.v2 ? "🔴 Ocupada" : "🟢 Disponível";
        v2.className = dados.v2 ? "status ocupado" : "status disponivel";

        // Atualiza a Vaga 3
        let v3 = document.getElementById('vaga3');
        v3.innerHTML = dados.v3 ? "🔴 Ocupada" : "🟢 Disponível";
        v3.className = dados.v3 ? "status ocupado" : "status disponivel";
      })
      .catch(err => console.error("Erro ao buscar dados do ESP32:", err));
  }

  // Executa a função imediatamente ao abrir o site
  atualizarDados();
  // Configura para rodar repetidamente a cada 1 segundo (1000ms)
  setInterval(atualizarDados, 1000);
</script>

</body>
</html>
)rawliteral";

  server.send(200, "text/html", html);
}

void handleStatus() {
  const int vagasOcupadasCount = contarVagasOcupadas();
  const int vagasDisponiveis = NUM_SENSORES - vagasOcupadasCount;

  String json = "{";
  json += "\"pronto\":" + String(vagasVerificadas ? "true" : "false") + ",";
  json += "\"disp\":" + String(vagasDisponiveis) + ",";
  json += "\"ocup\":" + String(vagasOcupadasCount) + ",";
  json += "\"v1\":" + String(vagasOcupadas[0] ? "true" : "false") + ",";
  json += "\"v2\":" + String(vagasOcupadas[1] ? "true" : "false") + ",";
  json += "\"v3\":" + String(vagasOcupadas[2] ? "true" : "false");
  json += "}";

  server.send(200, "application/json", json);
}

void setup() {

    Serial.begin(115200);
    cancela.setPeriodHertz(50);
    cancela.attach(PINO_SERVO, 500, 2400);
    cancela.write(ANGULO_FECHADO);
    WiFi.begin(ssid, password);
    server.on("/", handleRoot);
    server.on("/status", handleStatus);
    server.begin();

    // Botões
    // Cada botão conecta seu GPIO ao GND quando pressionado.
    pinMode(botaoPin, INPUT_PULLUP);
    pinMode(botaoSaida, INPUT_PULLUP);
    Serial.println("Entrada pronta no GPIO 22. Saida pronta no GPIO 23.");

    /*
      Percorre um loop for baseado na quantia de sensores
      baseado na lista declarada anteriormente, conecta os
      Sensores / leds
    */
    for (int i = 0; i < NUM_SENSORES; i++) {
        pinMode(trigPins[i], OUTPUT);
        digitalWrite(trigPins[i], LOW);
        pinMode(echoPins[i], INPUT);
        pinMode(ledPins[i], OUTPUT);
        digitalWrite(ledPins[i], LOW);

        pinMode(trigPinsAdas[i], OUTPUT);
        digitalWrite(trigPinsAdas[i], LOW);
        pinMode(echoPinsAdas[i], INPUT);
        pinMode(ledPinsAdas[i], OUTPUT);
        digitalWrite(ledPinsAdas[i], LOW);
    }
}

int medirDistancia(int trigPin, int echoPin) {
    digitalWrite(trigPin, HIGH);
    delayMicroseconds(10);
    digitalWrite(trigPin, LOW);
    return pulseIn(echoPin, HIGH, TEMPO_MAX_ECO_US) / 58;
}

void verificarVaga(int sensor) {
    const int distancia = medirDistancia(trigPins[sensor], echoPins[sensor]);
    const bool ocupada = distancia > 0 && distancia <= DISTANCIA_OCUPADA_CM;

    // Confirma a mudança em duas leituras para tolerar um eco perdido.
    if (ocupada == vagasOcupadas[sensor]) {
        mudancaPendente[sensor] = false;
    } else if (mudancaPendente[sensor]) {
        vagasOcupadas[sensor] = ocupada;
        mudancaPendente[sensor] = false;
        Serial.printf("VAGA %d: %s. Disponiveis: %d/%d.\n",
                      sensor + 1, ocupada ? "ocupada" : "livre",
                      NUM_SENSORES - contarVagasOcupadas(), NUM_SENSORES);
    } else {
        mudancaPendente[sensor] = true;
    }

    if (!vagasEmOrientacao[sensor]) {
        digitalWrite(ledPins[sensor], vagasOcupadas[sensor] ? HIGH : LOW);
        return;
    }

    digitalWrite(ledPins[sensor],
                 distancia > 0 && distancia <= DISTANCIA_ORIENTACAO_CM / 2 ? HIGH : LOW);

    if (vagasOcupadas[sensor] && distancia > 0 &&
        distancia <= DISTANCIA_ORIENTACAO_CM * 0.4) {
        for (int i = 0; i < NUM_SENSORES; i++) {
            vagasEmOrientacao[i] = false;
            digitalWrite(ledPins[i], vagasOcupadas[i] ? HIGH : LOW);
        }
    }
}

void concluirVerificacaoDeEntrada() {
    if (!entradaPendente) return;
    entradaPendente = false;

    const int livres = NUM_SENSORES - contarVagasOcupadas();
    if (livres == 0) {
        Serial.println("ENTRADA BLOQUEADA: todas as vagas estao ocupadas.");
        return;
    }

    for (int i = 0; i < NUM_SENSORES; i++) {
        vagasEmOrientacao[i] = !vagasOcupadas[i];
        digitalWrite(ledPins[i], vagasOcupadas[i] ? HIGH : LOW);
    }
    abrirCancela();
    Serial.printf("ENTRADA OK: %d/%d vagas livres. Cancela aberta.\n", livres, NUM_SENSORES);
}

void verificarProximoSensor() {
    static int proximaVaga = 0;
    static int proximoAdas = 0;
    static bool vezDoAdas = false;
    static unsigned long ultimoDisparo = 0;
    const unsigned long agora = millis();
    if (agora - ultimoDisparo < INTERVALO_SENSORES) return;
    ultimoDisparo = agora;

    // Um disparo por intervalo para evitar interferência entre os sensores.
    if (leiturasPrioritarias == 0 && vezDoAdas) {
        const int distancia = medirDistancia(trigPinsAdas[proximoAdas], echoPinsAdas[proximoAdas]);
        digitalWrite(ledPinsAdas[proximoAdas],
                     distancia > 0 && distancia <= DISTANCIA_ADAS_CM ? HIGH : LOW);
        proximoAdas = (proximoAdas + 1) % NUM_SENSORES;
        vezDoAdas = false;
        return;
    }

    verificarVaga(proximaVaga);
    proximaVaga = (proximaVaga + 1) % NUM_SENSORES;
    vezDoAdas = true;

    if (leiturasPrioritarias > 0 && --leiturasPrioritarias == 0) {
        vagasVerificadas = true;
        concluirVerificacaoDeEntrada();
    }
}

void loop() {
    if (cancelaAberta && millis() - aberturaCancela >= TEMPO_ABERTO) {
        cancela.write(ANGULO_FECHADO);
        cancelaAberta = false;
    }

    if (entrada.novoClique() && !entradaPendente) {
        entradaPendente = true;
        leiturasPrioritarias = LEITURAS_VERIFICACAO;
    }
    if (saida.novoClique()) {
        abrirCancela();
        leiturasPrioritarias = LEITURAS_VERIFICACAO;
        Serial.println("SAIDA OK: cancela aberta. Verificando quais vagas ficaram livres.");
    }

    verificarProximoSensor();
    server.handleClient();

    static bool ipExibido = false;
    if (!ipExibido && WiFi.status() == WL_CONNECTED) {
        Serial.print("IP do ESP32: ");
        Serial.println(WiFi.localIP());
        ipExibido = true;
    }
}
