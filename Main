/*
   ESTACIONAMENTO INTELIGENTE - ESP32
*/

#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>
#include <LittleFS.h>
#include <time.h>


/*
   Configuracoes da rede e do historico
*/

const char* ssid = "TESTE_ESP";
const char* password = "TESTE_ESP";


const bool FORMATAR_FLASH_SE_NECESSARIO = true;
const int TAMANHO_MAX_LOG = 32000;  // Historico limitado a aproximadamente 32 KB.

WebServer server(80);
Servo cancela;
bool flashDisponivel = false;



const int botaoPin = 22;
const int botaoSaida = 23;

// Sensores de estacionamento: TRIG / ECHO / LED.
const int trigPins[] = {5, 16, 21};
const int echoPins[] = {18, 17, 19};
const int ledPins[]  = {4, 14, 26};

// Sensores ADAS: TRIG / ECHO / LED.
const int trigPinsAdas[] = {12, 15, 2};
const int echoPinsAdas[] = {13, 34, 35};
const int ledPinsAdas[]  = {32, 33, 25};

const int NUM_SENSORES = sizeof(trigPins) / sizeof(trigPins[0]);
const int PINO_SERVO = 27;
const int ANGULO_FECHADO = 105;
const int ANGULO_ABERTO = 15;

const int DISTANCIA_ADAS_CM = 6;
const int DISTANCIA_OCUPADA_CM = 20;
const int DISTANCIA_ORIENTACAO_CM = 12;

const unsigned long TEMPO_ABERTO = 3000;
const unsigned long TEMPO_DEBOUNCE = 25;
const unsigned long INTERVALO_SENSORES = 60;

const unsigned long TEMPO_MAX_ECO_US = 4000;
const int LEITURAS_VERIFICACAO = 2 * NUM_SENSORES;


/*
   Variaveis do estacionamento
*/

bool cancelaAberta = false;
bool vagasOcupadas[NUM_SENSORES] = {};
bool vagasConhecidas[NUM_SENSORES] = {};
bool mudancaPendente[NUM_SENSORES] = {};
bool vagasEmOrientacao[NUM_SENSORES] = {};

int distanciasVaga[NUM_SENSORES] = {};
int distanciasAdas[NUM_SENSORES] = {};
int falhasVaga[NUM_SENSORES] = {};
int falhasAdas[NUM_SENSORES] = {};
int leiturasEntrada[NUM_SENSORES] = {};

bool entradaPendente = false;
bool vagasVerificadas = false;
int leiturasPrioritarias = LEITURAS_VERIFICACAO;
unsigned long aberturaCancela = 0;
unsigned long ultimaLeituraVaga[NUM_SENSORES] = {};


// Detecta um clique (botao ligado ao GND, usando INPUT_PULLUP).
struct Botao {
    explicit Botao(int pino) : pino(pino) {}

    bool novoClique() {
        const unsigned long agora = millis();
        const bool leitura = digitalRead(pino) == LOW;

        if (leitura != leituraAnterior) {
            leituraAnterior = leitura;
            ultimaMudanca = agora;
        }

        if (leitura == pressionado || agora - ultimaMudanca < TEMPO_DEBOUNCE) {
            return false;
        }

        pressionado = leitura;
        return pressionado;
    }

    const int pino;
    bool leituraAnterior = false;
    bool pressionado = false;
    unsigned long ultimaMudanca = 0;
};

Botao entrada(botaoPin);
Botao saida(botaoSaida);


/*
   Historico de eventos na memoria flash
*/

String dataHora() {
    time_t agora = time(nullptr);

    if (agora < 1704067200) {
        return "SEM_HORA (" + String(millis() / 1000) + "s desde inicializacao)";
    }

    struct tm horario;
    localtime_r(&agora, &horario);
    char texto[24];
    strftime(texto, sizeof(texto), "%d/%m/%Y %H:%M:%S", &horario);
    return String(texto);
}

// Registra INFO, WARNING ou ERROR na Serial e em /eventos.txt (LittleFS).
void registrar(const char* nivel, const String& mensagem) {
    String linha = dataHora() + " [" + nivel + "] " + mensagem + "\n";
    Serial.print(linha);

    if (!flashDisponivel) return;

    File arquivo = LittleFS.open("/eventos.txt", "a");
    if (!arquivo) {
        Serial.println("[ERROR] Nao foi possivel abrir o historico.");
        return;
    }

    // Ao atingir o limite, inicia um novo historico para nao ocupar toda a flash.
    if (arquivo.size() + linha.length() > TAMANHO_MAX_LOG) {
        arquivo.close();
        arquivo = LittleFS.open("/eventos.txt", "w");
        if (!arquivo) return;
        arquivo.print(dataHora() + " [WARNING] Historico antigo substituido por limite de espaco.\n");
    }

    arquivo.print(linha);
    arquivo.close();
}

void handleLogs() {
    if (!flashDisponivel) {
        server.send(503, "text/plain; charset=utf-8", "LittleFS indisponivel. Verifique a Serial.");
        return;
    }

    File arquivo = LittleFS.open("/eventos.txt", "r");
    if (!arquivo) {
        server.send(200, "text/plain; charset=utf-8", "Nenhum evento registrado.");
        return;
    }

    server.sendHeader("Cache-Control", "no-store");
    server.streamFile(arquivo, "text/plain; charset=utf-8");
    arquivo.close();
}


/*
   Controle da cancela e das vagas
*/

int contarVagasOcupadas() {
    int ocupadas = 0;
    for (int i = 0; i < NUM_SENSORES; i++) {
        if (vagasOcupadas[i]) ocupadas++;
    }
    return ocupadas;
}

void abrirCancela() {
    cancela.write(ANGULO_ABERTO);
    aberturaCancela = millis();
    cancelaAberta = true;
    registrar("INFO", "Cancela aberta.");
}

void fecharCancela() {
    if (!cancelaAberta) return;
    cancela.write(ANGULO_FECHADO);
    cancelaAberta = false;
    registrar("INFO", "Cancela fechada.");
}

// Inicia a verificacao das tres vagas antes de liberar a entrada.
void solicitarEntrada() {
    if (entradaPendente || cancelaAberta) return;

    entradaPendente = true;
    leiturasPrioritarias = LEITURAS_VERIFICACAO;
    for (int i = 0; i < NUM_SENSORES; i++) leiturasEntrada[i] = 0;
    registrar("INFO", "Entrada solicitada.");
}

void concluirVerificacaoDeEntrada() {
    if (!entradaPendente) return;
    entradaPendente = false;

    // Se algum sensor nao respondeu duas vezes, a entrada e bloqueada.
    for (int i = 0; i < NUM_SENSORES; i++) {
        bool recente = millis() - ultimaLeituraVaga[i] <= 2000;
        if (!vagasConhecidas[i] || leiturasEntrada[i] < 2 ||
            distanciasVaga[i] == 0 || !recente || mudancaPendente[i]) {
            registrar("WARNING", "Entrada bloqueada: sensor de vaga sem leitura confiavel.");
            return;
        }
    }

    const int livres = NUM_SENSORES - contarVagasOcupadas();
    if (livres == 0) {
        registrar("WARNING", "Entrada bloqueada: estacionamento lotado.");
        return;
    }

    for (int i = 0; i < NUM_SENSORES; i++) {
        vagasEmOrientacao[i] = !vagasOcupadas[i];
    }

    abrirCancela();
    registrar("INFO", "Entrada autorizada. Vagas livres: " + String(livres));
}

int medirDistancia(int trigPin, int echoPin) {
    digitalWrite(trigPin, LOW);
    delayMicroseconds(2);
    digitalWrite(trigPin, HIGH);
    delayMicroseconds(10);
    digitalWrite(trigPin, LOW);

    const unsigned long duracao = pulseIn(echoPin, HIGH, TEMPO_MAX_ECO_US);
    return duracao == 0 ? 0 : duracao / 58;
}

void verificarVaga(int sensor) {
    const int distancia = medirDistancia(trigPins[sensor], echoPins[sensor]);
    distanciasVaga[sensor] = distancia;
    ultimaLeituraVaga[sensor] = millis();

    if (distancia == 0) {
        mudancaPendente[sensor] = false;
        leiturasEntrada[sensor] = 0;
        falhasVaga[sensor]++;
        if (falhasVaga[sensor] == 5) {
            registrar("WARNING", "Vaga " + String(sensor + 1) + ": sensor sem eco.");
        }
        return;  // Eco perdido nao significa vaga livre.
    }

    if (falhasVaga[sensor] >= 5) {
        registrar("INFO", "Vaga " + String(sensor + 1) + ": sensor recuperado.");
    }
    falhasVaga[sensor] = 0;
    if (entradaPendente) leiturasEntrada[sensor]++;

    const bool ocupada = distancia <= DISTANCIA_OCUPADA_CM;

    // Confirma a ocupacao com duas leituras seguidas.
    if (vagasConhecidas[sensor] && ocupada == vagasOcupadas[sensor]) {
        mudancaPendente[sensor] = false;
    } else if (mudancaPendente[sensor]) {
        vagasOcupadas[sensor] = ocupada;
        vagasConhecidas[sensor] = true;
        mudancaPendente[sensor] = false;
        registrar("INFO", "Vaga " + String(sensor + 1) + (ocupada ? " ocupada." : " livre."));
    } else {
        mudancaPendente[sensor] = true;
    }

    if (!vagasEmOrientacao[sensor]) {
        digitalWrite(ledPins[sensor], vagasOcupadas[sensor] ? HIGH : LOW);
        return;
    }

    digitalWrite(ledPins[sensor], distancia <= DISTANCIA_ORIENTACAO_CM / 2 ? HIGH : LOW);
    if (vagasOcupadas[sensor] && distancia <= DISTANCIA_ORIENTACAO_CM * 0.4) {
        for (int i = 0; i < NUM_SENSORES; i++) {
            vagasEmOrientacao[i] = false;
            digitalWrite(ledPins[i], vagasOcupadas[i] ? HIGH : LOW);
        }
        registrar("INFO", "Orientacao das vagas encerrada.");
    }
}

void verificarProximoSensor() {
    static int proximaVaga = 0;
    static int proximoAdas = 0;
    static bool vezDoAdas = false;
    static unsigned long ultimoDisparo = 0;

    if (millis() - ultimoDisparo < INTERVALO_SENSORES) return;
    ultimoDisparo = millis();

    // Dispara apenas um sensor por vez, evitando interferencia.
    if (leiturasPrioritarias == 0 && vezDoAdas) {
        const int distancia = medirDistancia(trigPinsAdas[proximoAdas], echoPinsAdas[proximoAdas]);
        distanciasAdas[proximoAdas] = distancia;
        digitalWrite(ledPinsAdas[proximoAdas],
                     distancia > 0 && distancia <= DISTANCIA_ADAS_CM ? HIGH : LOW);

        if (distancia == 0) {
            if (++falhasAdas[proximoAdas] == 5) {
                registrar("WARNING", "ADAS " + String(proximoAdas + 1) + ": sensor sem eco.");
            }
        } else {
            falhasAdas[proximoAdas] = 0;
        }

        proximoAdas = (proximoAdas + 1) % NUM_SENSORES;
        vezDoAdas = false;
        return;
    }

    verificarVaga(proximaVaga);
    proximaVaga = (proximaVaga + 1) % NUM_SENSORES;
    vezDoAdas = true;

    if (leiturasPrioritarias > 0 && --leiturasPrioritarias == 0) {
        vagasVerificadas = true;
        concluirVerificacaoDeEntrada();
    }
}


/*
   Pagina web 
*/

