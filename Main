  }

  // Executa a função imediatamente ao abrir o site
  atualizarDados();
  // Configura para rodar repetidamente a cada 1 segundo (1000ms)
  setInterval(atualizarDados, 1000);
</script>

</body>
</html>
)rawliteral";

  server.send(200, "text/html", html);
}

void handleStatus() {
  int vagasOcupadasCount = 0;
  for (int i = 0; i < NUM_SENSORES; i++) {
    if (vagasOcupadas[i]) vagasOcupadasCount++;
  }
  int vagasDisponiveis = NUM_SENSORES - vagasOcupadasCount;

  String json = "{";
  json += "\"disp\":" + String(vagasDisponiveis) + ",";
  json += "\"ocup\":" + String(vagasOcupadasCount) + ",";
  json += "\"v1\":" + String(vagasOcupadas[0] ? "true" : "false") + ",";
  json += "\"v2\":" + String(vagasOcupadas[1] ? "true" : "false") + ",";
  json += "\"v3\":" + String(vagasOcupadas[2] ? "true" : "false");
  json += "}";

  server.send(200, "application/json", json);
}

void setup() {

    Serial.begin(115200);
    cancela.setPeriodHertz(50);
    cancela.attach(PINO_SERVO, 500, 2400);
    cancela.write(ANGULO_FECHADO);
    WiFi.begin(ssid, password);
    server.on("/", handleRoot);
    server.on("/status", handleStatus);
    server.begin();

    // Botões
    pinMode(botaoPin, INPUT_PULLUP);   // Inicia o botão de entrada
    pinMode(botaoSaida, INPUT_PULLUP); // Inicia o botão de saída

    /*
      Percorre um loop for baseado na quantia de sensores
      baseado na lista declarada anteriormente, conecta os
      Sensores / leds
    */
    for (int i = 0; i < NUM_SENSORES; i++) {
        pinMode(trigPins[i], OUTPUT);
        pinMode(echoPins[i], INPUT);
        pinMode(ledPins[i], OUTPUT);
    }
    for (int i = 0; i < NUM_SENSORES; i++) {
        pinMode(trigPinsAdas[i], OUTPUT);
        pinMode(echoPinsAdas[i], INPUT);
        pinMode(ledPinsAdas[i], OUTPUT);
    }


    AtualizarTela();
}

/*
  Loop principal do sistema, onde a base principal é feita
  Verifica os botões inicialmente, esperando a entrada no botão de entrada
  Caso botão de entrada seja pressionado, continua para o sistema
  Verifica sensores constantemente chamando a função
*/
// ================= LOOP =================
void loop() {
    static bool ipExibido = false;
    if (!ipExibido && WiFi.status() == WL_CONNECTED) {
        Serial.print("IP do ESP32: ");
        Serial.println(WiFi.localIP());
        ipExibido = true;
    }
    server.handleClient();
    if (cancelaAberta && millis() - aberturaCancela >= TEMPO_ABERTO) {
        cancela.write(ANGULO_FECHADO);
        cancelaAberta = false;
    }

    // Verificação dos botões
    verificarBotao();      // Verifica se o botão de entrada foi pressionado
    verificarBotaoSaida(); // Verifica se o botão de saída foi pressionado
    // VerificarTodosAdas(); - Sem uso na maquete
    VerificarTodosAdas();

    // Sistema desligado
    /*
      Mantém o sistema preso nessa parte enquanto o botão de entrada não for pressionado
    */
    if (!sistemaLiberado)
    {
        Serial.println("Sistema aguardando botão...");
        delay(100);

    }

    // Leitura dos sensores
    /*
      Percorre um loop for baseado na quantia de sensores
      baseado na lista declarada anteriormente, checa os sensores
      com pequeno delay para evitar eco (Não ocorre no wokwi, mas ocorreria na vida real)
      Chama função de verificação de distância
    */
    VerificarTodosEstacionamentos();
}

void VerificarTodosEstacionamentos() {
    for (int i = 0; i < NUM_SENSORES; i++) {

        // Elimina qualquer pulso anterior
        digitalWrite(trigPins[i], LOW);
        delayMicroseconds(2);

        // Inicia pulso atual
        digitalWrite(trigPins[i], HIGH);
        delayMicroseconds(10);

        // Finaliza o pulso atual após 10 micro segundos
        digitalWrite(trigPins[i], LOW);

        /*
          Chama a função de verificação de distância
          Envia:
          i = Número do sensor
       */
        verificarDistancia(i);
        delay(50);
    }
}

void VerificarAdas(int sensor) {
    // Elimina qualquer pulso anterior
    digitalWrite(trigPinsAdas[sensor], LOW);
    delayMicroseconds(2);

    // Inicia pulso atual
    digitalWrite(trigPinsAdas[sensor], HIGH);
    delayMicroseconds(10);

    // Finaliza o pulso atual após 10 micro segundos
    digitalWrite(trigPinsAdas[sensor], LOW);

    /*
        Chama a função de verificação de distância
        Envia:
        i = Número do sensor
    */
    SensorAdasMaquete(sensor);
    delay(50);
}

// Sem uso para maquete
void VerificarTodosAdas() {
    for (int i = 0; i < NUM_SENSORES; i++) {
        VerificarAdas(i);
    }
}

void AtualizarTela() {

}

// ================= BOTÃO ENTRADA =================
void verificarBotao() {
    bool pressionada = digitalRead(botaoPin) == LOW;
    bool novoClique = pressionada && !entradaPressionada;
    entradaPressionada = pressionada;

    // Limite máximo do número de sensores
    if (cont_botao > NUM_SENSORES)
    {
        // Bloqueia o sistema
        sistemaLiberado = false;
        return;
    }

    // Caso a quantia for menor que o máximo de sensores e o botão seja pressionado
    if (novoClique)
    {
        // Primeiro clique OU cooldown (Debounce) concluído
        if (millis() - ultimoCliqueValido >= cooldownBotao || cont_botao == 0)
        {

            // Salva o ultimo clique em milissegundos para cooldown (Debounce)
            ultimoCliqueValido = millis();

            sistemaLiberado = true;

            // Incrementa entrada
            cont_botao++;
            abrirCancela();

            Serial.print("Sistema iniciado. Total: ");
            Serial.println(cont_botao);

            delay(300);
        }
    }
}

// ================= BOTÃO SAÍDA =================
void verificarBotaoSaida() {
    bool pressionada = digitalRead(botaoSaida) == LOW;
    bool novoClique = pressionada && !saidaPressionada;
    saidaPressionada = pressionada;

    // Caso botão seja pressionado
    if (novoClique)
    {

        // Verifica cooldown (Debounce)
        if (ultimoCliqueValidoSaida == 0 || millis() - ultimoCliqueValidoSaida >= cooldownBotao)
        {

            // Garante que existe ao menos um veiculo estacionado
            if (cont_botao > 0)
            {
                cont_botao--;
            }

            // Se zerar, desliga sistema
            if (cont_botao <= 0)
            {

                cont_botao = 0;
                sistemaLiberado = false;
            }

            // Salva ultimo clique em milissegundos para cooldown (Debounce)
            ultimoCliqueValidoSaida = millis();
            abrirCancela();

            Serial.print("Veiculo saiu. Total: ");
            Serial.println(cont_botao);

            AtualizarTela();

            delay(300);
        }
    }
}

void PiscarLed(
    int Tempo,
    int Led) {
}

// Funções que retornam tem que ser definidas com o tipo do return (paia)
int DistanciaSensor(
    int sensor
) {
    int echoPin  = echoPins[sensor];
    // Verifica duração de tempo do som até algo
    int duration = pulseIn(echoPin, HIGH, 30000);

    // Matemática transformando duração em distância
    int distance = duration / 58;
    return distance;
}

int DistanciaSensorAdas(
    int sensor
) {
    int echoPin  = echoPinsAdas[sensor];
    // Verifica duração de tempo do som até algo
    int duration = pulseIn(echoPin, HIGH, 30000);

    // Matemática transformando duração em distância
    int distance = duration / 58;
    return distance;
}

/*
  função de verificação de distância
  Recebe:
  Número do sensor
  Pin do echo do sensor
  Pin do led do sensor

  Verifica os sensores
  Caso sensor não funcione (0 como entrada):
    Mantém led aceso

  Lida com leds baseado na distância captada no sensor
*/
// ================= DISTÂNCIA =================
void verificarDistancia(
    int sensor
    )
{

    int distance = DistanciaSensor(sensor);
    vagasOcupadas[sensor] = distance > 0 && distance <= 20;
    if (!sistemaLiberado) {
        return;
    }

    Serial.print("Sensor ");
    Serial.print(sensor + 1);
    Serial.print(" - Distancia: ");
    Serial.println(distance);

    // ================= SEM LEITURA =================
    // Caso sensor falhe, mantém led ligado
    if (distance == 0) {
        FalhaSensor(sensor);
    }

    // ================= ACIMA DE 100 =================
    // Caso a distância seja maior que 100, mantém tudo desligado
    else if (distance > DISTANCIASENSOR) {
        ForaDistancia(sensor);
    }

    // ================= ENTRE 80 E 100 =================
    /*
      Distância entre 80-100
      Inicializa o sistema, permitindo que distâncias mais próximas possam rodar
   */
    else if (distance > DISTANCIASENSOR * 0.8) {
        DistanciaInicial(sensor);
    }

    else if (inicio[sensor]) {

        // ================= ENTRE 50 E 80 =================
        if (distance > DISTANCIASENSOR * 0.5) {
            EstacionandoInicial(sensor);
        }

        // ================= ENTRE 15 E 50 =================
        else if (distance > DISTANCIASENSOR * 0.2) {
            EstacionandoMeio(sensor);
        }

        // ============== MENOR OU IGUAL A 15 =================
        else if (distance <= DISTANCIASENSOR * 0.3) {
            EstacionandoFinal(sensor);
        }
    }

    delay(100);
}

void FalhaSensor(
    int sensor
) {
    int ledPin        = ledPins[sensor];
    digitalWrite(ledPin, HIGH);
}

void ForaDistancia(
    int sensor
) {
    int ledPin       = ledPins[sensor];
    digitalWrite(ledPin, LOW);

    contando[sensor] = false;
    inicio[sensor]   = false;
}

void DistanciaInicial(
    int sensor
) {
    int ledPin       = ledPins[sensor];
    inicio[sensor]   = true;

    digitalWrite(ledPin, LOW);
}

void EstacionandoInicial(
    int sensor
) {
    int ledPin       = ledPins[sensor];
    digitalWrite(ledPin, LOW);
}

void EstacionandoMeio(
    int sensor
) {
    int ledPin       = ledPins[sensor];
    digitalWrite(ledPin, HIGH);
}

void EstacionandoFinal(
    int sensor
) {
    int ledPin       = ledPins[sensor];
    digitalWrite(ledPin, HIGH);

    contando[sensor] = false;
    inicio[sensor]   = false;

    sistemaLiberado  = false;
    AtualizarTela();
}

// Parte Adas 2

void SensorAdas(
    int sensor
) {
    int echoPin = echoPinsAdas[sensor];
    int ledPin  = ledPinsAdas[sensor];

    int distance = DistanciaSensorAdas(sensor);
    if (distance < DISTANCIAADAS) {
        digitalWrite(ledPin, HIGH);
    } else {
        digitalWrite(ledPin, LOW);
    }

}

void AcenderLed(int index) {
    int ledPin = ledPinsAdas[index];
    digitalWrite(ledPin, HIGH);
}

void ApagarLed(int index) {
    int ledPin = ledPinsAdas[index];
    digitalWrite(ledPin, LOW);
}

void ApagarTodosLed() {
    for (int i = 0; i < NUM_SENSORES; i++) {
        ApagarLed(i);
    }
}

void SensorAdasMaquete(
    int sensor
) {
    int distance = DistanciaSensorAdas(sensor);
    digitalWrite(ledPinsAdas[sensor], distance > 0 && distance <= DISTANCIAADAS ? HIGH : LOW);
}

